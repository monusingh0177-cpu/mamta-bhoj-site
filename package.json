{
  "name": "mamta-bhoj-site",
  "version": "1.0.0",
  "description": "Website + admin panel for Mamta Bhoj (Devmam Flourish Foods LLP) - flour mill, Chaubepur, Kanpur",
  "main": "server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "seo:hard-check": "bash scripts/seo-hard-check.sh",
    "seo:indexnow": "node scripts/indexnow-submit.js",
    "test:enquiry": "node scripts/test-enquiry.js",
    "test:enquiry-unit": "node scripts/test-enquiry-unit.js",
    "test:crm-forward": "node scripts/test-crm-forward.js",
    "seo:auto": "node autopilot/cli.js run",
    "seo:dry-run": "node autopilot/cli.js dry-run",
    "seo:report": "node autopilot/cli.js report",
    "seo:enable": "node autopilot/cli.js enable",
    "seo:disable": "node autopilot/cli.js disable",
    "seo:rollback": "node autopilot/cli.js rollback",
    "seo:audit-log": "node autopilot/cli.js audit-log",
    "test:autopilot": "node scripts/test-autopilot.js",
    "test:ai": "node scripts/test-ai-gemini.js",
    "test:ai-budget": "node scripts/test-ai-budget.js",
    "test:deploy-guard": "node scripts/test-deploy-guard.js",
    "test:funnel": "node scripts/test-funnel.js"
  },
  "dependencies": {
    "nodemailer": "^10.0.10"
  }
}
