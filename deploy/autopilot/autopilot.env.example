# /etc/mamta-autopilot/autopilot.env   (chmod 600, owned by the service user; NEVER commit a real copy)
# Everything here is optional. With nothing set, the autopilot runs in report-only mode.

# --- mode ---------------------------------------------------------------------------------
# report  = audit + report only (default)
# propose = ALSO prepare validated fixes on a separate git branch for review. Nothing is merged, pushed or restarted.
# auto    = ALSO publish ELIGIBLE fixes without approval (deterministic internal-link fixes only; AI-written copy always
#           stays on a review branch): quality gates -> fast-forward -> restart -> live verification -> push, with
#           automatic rollback. Needs AUTOPILOT_RESTART_CMD below plus write access for the service (see
#           docs/seo-autopilot.md, "Automatic publishing"). Switch to it only after report and propose runs look right.
AUTOPILOT_MODE=report
# Not a switch. Leave it as "branch": AUTOPILOT_PUBLISH=auto is refused (use AUTOPILOT_MODE=auto instead).
AUTOPILOT_PUBLISH=branch

# --- automatic publishing (only used when AUTOPILOT_MODE=auto) -----------------------------
# Restart command, run as the service user after a release and after a rollback. TRUSTED input: executed as written.
#AUTOPILOT_RESTART_CMD=pm2 restart mamta-bhoj
#AUTOPILOT_GIT_REMOTE=origin
#AUTOPILOT_GIT_BRANCH=main
#AUTOPILOT_AUTO_MAX_PER_DAY=1      # releases per day
#AUTOPILOT_MAX_FIXES_PER_DAY=1     # deterministic fixes (proposed or published) per day
#AUTOPILOT_MIN_INLINKS=3           # audit: a page with fewer internal links pointing to it is a finding
#AUTOPILOT_OPPORTUNITY_INLINKS=5   # a guide that is the best page for a rising query but has fewer links gets one more
#AUTOPILOT_TARGET_KEYWORDS_FILE=/etc/mamta-autopilot/target-keywords.txt   # one keyword per line

# --- where things are ----------------------------------------------------------------------
AUTOPILOT_SITE_ORIGIN=https://devmamflourishfoods.com
# Pages are read from here (default: the live site). A local URL such as http://127.0.0.1:3000 also works.
AUTOPILOT_FETCH_BASE=https://devmamflourishfoods.com
# Copy this directory's data/ (read-only) into previews so they render the real content. Default: <repo>/data
#AUTOPILOT_DATA_DIR=/var/www/mamta-bhoj-site/data

# --- Google Search Console (OAuth 2.0 refresh-token flow) ----------------------------------
# Create an OAuth client (Desktop app) in Google Cloud, enable the "Google Search Console API", and authorise the
# account that owns the property once to obtain a refresh token. Scope webmasters (not only .readonly) is needed
# to submit the sitemap; webmasters.readonly is enough for reporting and URL Inspection.
AUTOPILOT_GSC_SITE=sc-domain:devmamflourishfoods.com
#AUTOPILOT_GOOGLE_CLIENT_ID=
#AUTOPILOT_GOOGLE_CLIENT_SECRET=
#AUTOPILOT_GOOGLE_REFRESH_TOKEN=

# --- AI (optional; without it patch generation is report-only) -----------------------------
# none | openai (any OpenAI-compatible chat API) | anthropic | claude-cli
AUTOPILOT_AI_MODE=none
#AUTOPILOT_AI_BASE_URL=https://api.openai.com/v1
#AUTOPILOT_AI_MODEL=
#AUTOPILOT_AI_API_KEY=

# --- limits -------------------------------------------------------------------------------
#AUTOPILOT_MAX_PAGES_PER_DAY=2
#AUTOPILOT_COOLDOWN_DAYS=14
#AUTOPILOT_MIN_SCORE=40
#AUTOPILOT_INSPECT_PER_RUN=10

# --- optional ------------------------------------------------------------------------------
# Read-only `pm2 jlist` check in the smoke test (the autopilot never restarts anything).
#AUTOPILOT_PM2_CHECK=1
#AUTOPILOT_ALERT_WEBHOOK=
